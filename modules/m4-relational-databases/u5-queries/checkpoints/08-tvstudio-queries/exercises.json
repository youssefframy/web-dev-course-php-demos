    "exercises": [
        {
            "id": "m4u5-08-topup",
            "type": "script",
            "db": "tvstudio",
            "file": "/db/tvstudio/tvstudio-topup.sql",
            "twice": true,
            "assert": [
                {
                    "sql": "SELECT COUNT(*) FROM Series WHERE name IN ('Night Desk', 'Coming Soon')",
                    "equals": "2",
                    "say": "new series"
                },
                {
                    "sql": "SELECT COUNT(*) FROM Director WHERE name = 'Rita' AND surname = 'Azzopardi'",
                    "equals": "1",
                    "say": "Rita Azzopardi"
                },
                {
                    "sql": "SELECT COUNT(*) FROM Station WHERE CHAR_LENGTH(name) > 50",
                    "equals": "1",
                    "say": "stations with names over 50 characters"
                }
            ],
            "hint": "Run ./sql shell tvstudio < db/tvstudio/tvstudio-topup.sql twice by hand, and compare the row counts."
        },
